# Loaded by `vite --mode mock` (yarn dev:mock), which points the app at the
# local fixture server in scripts/mock-api.mjs instead of production.
#
# Committed deliberately: it holds no secrets, and the acceptance pass is not
# reproducible if every developer has to reconstruct this by hand.
#
# Run the server alongside it:  yarn mock-api
VITE_AQRA_API_URL=http://localhost:8081/api/v1
