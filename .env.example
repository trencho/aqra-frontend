# Copy to .env.local (development) or .env.production and adjust as needed.
# Only variables prefixed VITE_ are exposed to the client bundle.

# Base URL of the AQRA REST API.
# Optional -- defaults to https://aqra.feit.ukim.edu.mk/api/v1 when unset.
VITE_AQRA_API_URL=https://aqra.feit.ukim.edu.mk/api/v1
